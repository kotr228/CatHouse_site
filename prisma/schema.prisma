generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String?
  description String
  status      OrderStatus @default(NEW)
  locale      String      @default("uk")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("orders")
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Service {
  id           String               @id @default(cuid())
  slug         String               @unique
  icon         String?
  order        Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ServiceTranslation[]
  prices       Price[]

  @@map("services")
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  title       String
  description String   @db.Text
  features    String[]
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
  @@map("service_translations")
}

model Price {
  id        String   @id @default(cuid())
  serviceId String
  currency  String   @default("USD")
  amount    Decimal  @db.Decimal(10, 2)
  period    String?
  isActive  Boolean  @default(true)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("prices")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("admin_users")
}

model SiteSettings {
  id               String   @id @default("singleton")
  // Logo & brand
  logoText         String   @default("DevStudio")
  logoImageUrl     String? @db.Text
  siteName         String   @default("DevStudio")
  siteTagline      String   @default("Professional Software Development")
  // Colors (hex values)
  colorPrimary     String   @default("#6366f1")
  colorSecondary   String   @default("#8b5cf6")
  colorAccent      String   @default("#06b6d4")
  colorBg          String   @default("#020617")
  colorBgCard      String   @default("#0f172a")
  colorText        String   @default("#f8fafc")
  colorTextMuted   String   @default("#94a3b8")
  // Background
  bgType           String   @default("gradient")
  // Animation variant: "fade" | "slide" | "scale" | "bounce" | "none"
  animationVariant String   @default("fade")
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

model HeroContent {
  id           String @id
  locale       String @unique
  title        String @db.Text
  subtitle     String @db.Text
  ctaPrimary   String
  ctaSecondary String

  @@map("hero_content")
}

model StatItem {
  id        String  @id @default(cuid())
  value     String
  labelUk   String
  labelEn   String
  labelPl   String
  labelLt   String
  order     Int     @default(0)
  isVisible Boolean @default(true)

  @@map("stat_items")
}

model PageBlock {
  id        String  @id
  label     String
  isVisible Boolean @default(true)
  order     Int     @default(0)

  @@map("page_blocks")
}
